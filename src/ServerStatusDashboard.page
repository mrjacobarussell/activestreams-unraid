<style>
    /* Self-contained icon sizing - do not rely on ActiveStreamsDashboard.page's
       .as-icon-img being present, since Unraid lets users show/hide dashboard
       tiles independently and that sibling file may not be loaded. */
    .ss-icon-img { width: 32px; height: 32px; }

    .ss-row-block {
        display: flex;
        align-items: center;
        width: 100%;
        box-sizing: border-box;
        padding: 6px 0;
        border-bottom: 1px solid rgba(255,255,255,0.05);
    }
    .ss-row-block:last-child { border-bottom: none; }

    .ss-row-label {
        flex: 0 0 90px;
        width: 90px;
        font-weight: 600;
        opacity: 0.85;
    }

    /* row-reverse: fills dots right-to-left while DOM order stays equal to
       server-config order, so the HTML from activestreams_status.php can be
       dropped in as-is with no client-side reordering */
    .ss-dot-row {
        display: flex;
        flex-direction: row-reverse;
        flex-wrap: wrap;
        align-items: center;
        gap: 6px;
        flex: 1 1 auto;
        min-height: 12px;
    }

    .ss-dot {
        display: inline-block;
        width: 10px;
        height: 10px;
        flex: 0 0 10px;
        border-radius: 50%;
    }

    .ss-on-green  { background-color: #8cc43c; }
    .ss-on-red    { background-color: #d9534f; }
    .ss-off-black { background-color: #555; }

    /* Applied to the tile header when a poll fails (500/404/etc), so stale
       dots aren't mistaken for a fresh read. */
    .ss-poll-error { opacity: 0.5; }
</style>

